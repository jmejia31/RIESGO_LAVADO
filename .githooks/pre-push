#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
  python3 tools/validate_agent_skills.py
elif command -v python >/dev/null 2>&1; then
  python tools/validate_agent_skills.py
elif command -v py >/dev/null 2>&1; then
  py -3 tools/validate_agent_skills.py
else
  echo 'BLOQUEADO: Python 3 no esta disponible para validar Agent Skills.' >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = 'refs/heads/main' ]; then
    echo 'BLOQUEADO: push directo a main no autorizado por el protocolo RIESGO_LAVADO.' >&2
    echo 'Publica en desarrollo. Solo una autorizacion expresa de Javier Mejia puede justificar --no-verify.' >&2
    exit 1
  fi
done
