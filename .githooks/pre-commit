#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

branch="$(git branch --show-current)"
if [ "$branch" = "main" ]; then
  echo 'BLOQUEADO: el protocolo RIESGO_LAVADO no permite commits ordinarios en main.' >&2
  echo 'Trabaja en desarrollo. Solo una autorizacion expresa de Javier Mejia puede justificar --no-verify.' >&2
  exit 1
fi

staged="$(git diff --cached --name-only)"
root_agents=0
nested_agents=0
printf '%s\n' "$staged" | grep -qx 'AGENTS.md' && root_agents=1 || true
printf '%s\n' "$staged" | grep -qx '.agents/AGENTS.md' && nested_agents=1 || true
if [ "$root_agents" -ne "$nested_agents" ]; then
  echo 'BLOQUEADO: AGENTS.md y .agents/AGENTS.md deben actualizarse en la misma intervencion.' >&2
  exit 1
fi

if command -v python3 >/dev/null 2>&1; then
  python3 tools/validate_agent_skills.py
elif command -v python >/dev/null 2>&1; then
  python tools/validate_agent_skills.py
elif command -v py >/dev/null 2>&1; then
  py -3 tools/validate_agent_skills.py
else
  echo 'BLOQUEADO: Python 3 no esta disponible para validar Agent Skills.' >&2
  exit 1
fi
